# Solo Vault — encrypted secret storage (optional)
# When set, credentials are fetched on-demand from Solo Vault instead of .env.
# Provision a service-scoped read token (not the admin key).
# SOLO_VAULT_TOKEN=svt_your_read_token_here
# SOLO_VAULT_URL=https://api.vault.jeffreykeyser.net
# SOLO_VAULT_PROJECT=nanoclaw
# SOLO_VAULT_ENV=production

# Provider-agnostic agent runner. Per-group overrides may be placed in
# groups/<folder>/container.json using provider/cliBin/model and
# fallbackProvider/fallbackCliBin/fallbackModel.
AGENT_RUNNER_BACKEND=opencode
AGENT_CLI_BIN=opencode
AGENT_MODEL=opencode-go/deepseek-v4-flash
AGENT_FALLBACK_BACKEND=codex
AGENT_FALLBACK_CLI_BIN=codex
AGENT_FALLBACK_MODEL=gpt-5.6-terra
