#!/bin/bash
# merge-pr — Merge a GitHub PR with CI wait logic and branch cleanup.
#
# Usage: merge-pr <pr-number> [--squash|--merge|--rebase] [--no-delete-branch]
#
# Edge cases handled:
#   - CI checks pending (waits with timeout)
#   - CI checks failing (clear error, does not merge)
#   - Branch deletion errors after merge (non-fatal warning)
#   - PR already merged (skip, report success)
#   - PR not found / closed (clear error)
#   - Merge strategy selection (squash default, merge, rebase)
set -euo pipefail

# ---------- defaults ----------
STRATEGY="squash"
DELETE_BRANCH=true
CI_TIMEOUT=300       # 5 minutes max wait for CI
CI_POLL_INTERVAL=10  # poll every 10 seconds
PR_NUMBER=""

# ---------- helpers ----------
die()  { echo "ERROR: $*" >&2; exit 1; }
warn() { echo "WARN: $*" >&2; }
info() { echo "INFO: $*"; }

usage() {
  cat <<EOF
Usage: merge-pr <pr-number> [--squash|--merge|--rebase] [--no-delete-branch]

Arguments:
  pr-number           The PR number to merge (required).

Options:
  --squash            Squash and merge (default).
  --merge             Create a merge commit.
  --rebase            Rebase and merge.
  --no-delete-branch  Keep the remote branch after merging.
  --ci-timeout <sec>  Max seconds to wait for CI (default: 300).
  -h, --help          Show this help message.
EOF
  exit 0
}

# ---------- arg parsing ----------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --squash)  STRATEGY="squash" ;;
    --merge)   STRATEGY="merge" ;;
    --rebase)  STRATEGY="rebase" ;;
    --no-delete-branch) DELETE_BRANCH=false ;;
    --ci-timeout) shift; CI_TIMEOUT="${1:-300}" ;;
    -h|--help) usage ;;
    -*)        die "Unknown option: $1" ;;
    *)
      if [[ -z "$PR_NUMBER" ]]; then
        # Validate that it looks like a number.
        [[ "$1" =~ ^[0-9]+$ ]] || die "PR number must be numeric, got: $1"
        PR_NUMBER="$1"
      else
        die "Unexpected argument: $1"
      fi
      ;;
  esac
  shift
done

[[ -z "$PR_NUMBER" ]] && die "PR number is required. Run 'merge-pr --help' for usage."

# ---------- prerequisite checks ----------
command -v gh >/dev/null 2>&1 || die "gh CLI is not installed. Install it: https://cli.github.com"
git rev-parse --git-dir >/dev/null 2>&1 || die "Not inside a git repository."

# ---------- PR state check ----------
PR_STATE=$(gh pr view "$PR_NUMBER" --json state --jq '.state' 2>/dev/null || true)

case "$PR_STATE" in
  MERGED)
    info "PR #$PR_NUMBER is already merged."
    exit 0
    ;;
  CLOSED)
    die "PR #$PR_NUMBER is closed (not merged). Re-open it first or check the PR number."
    ;;
  OPEN)
    # Good — proceed.
    ;;
  "")
    die "PR #$PR_NUMBER not found. Check the PR number and repository."
    ;;
  *)
    die "PR #$PR_NUMBER is in unexpected state: $PR_STATE"
    ;;
esac

# Capture branch name and other metadata for validation.
PR_BRANCH=$(gh pr view "$PR_NUMBER" --json headRefName --jq '.headRefName' 2>/dev/null || true)
PR_TITLE=$(gh pr view "$PR_NUMBER" --json title --jq '.title' 2>/dev/null || true)
PR_BASE=$(gh pr view "$PR_NUMBER" --json baseRefName --jq '.baseRefName' 2>/dev/null || true)

info "=== Pre-merge validation ==="
info "  PR: #$PR_NUMBER"
info "  Title: ${PR_TITLE:-unknown}"
info "  Branch: ${PR_BRANCH:-unknown} -> ${PR_BASE:-unknown}"
info "  Strategy: $STRATEGY"
info "  Delete branch: $DELETE_BRANCH"
info ""

# ---------- CI check wait ----------
# Wait for required status checks to pass before merging.
WAITED=0
CI_API_FAILURES=0
MAX_CI_API_FAILURES=3
LAST_STATUS_SUMMARY=""

while [[ $WAITED -lt $CI_TIMEOUT ]]; do
  # gh pr checks returns exit code 1 if checks are failing/pending.
  # Capture exit code separately to distinguish API errors from check failures.
  CHECK_EXIT=0
  CHECK_OUTPUT=$(gh pr checks "$PR_NUMBER" 2>&1) || CHECK_EXIT=$?

  # Detect API/auth/network errors: if gh failed AND the output doesn't contain
  # typical check-status keywords (pass/fail/pending), it's likely an API error.
  if [[ $CHECK_EXIT -ne 0 ]]; then
    PASS_COUNT=$(echo "$CHECK_OUTPUT" | grep -c "pass" || true)
    FAIL_COUNT=$(echo "$CHECK_OUTPUT" | grep -c "fail" || true)
    PENDING_COUNT=$(echo "$CHECK_OUTPUT" | grep -c "pending\|queued\|in_progress" || true)

    if [[ $((PASS_COUNT + FAIL_COUNT + PENDING_COUNT)) -eq 0 ]]; then
      # No recognizable check statuses — this is an API/network error, not a check result.
      CI_API_FAILURES=$((CI_API_FAILURES + 1))

      # Classify error type for better messaging.
      if echo "$CHECK_OUTPUT" | grep -qiE "timeout|timed out|connection|network"; then
        warn "Network error checking CI status (attempt $CI_API_FAILURES/$MAX_CI_API_FAILURES)"
      elif echo "$CHECK_OUTPUT" | grep -qiE "rate limit|429"; then
        warn "GitHub API rate limit hit (attempt $CI_API_FAILURES/$MAX_CI_API_FAILURES)"
      elif echo "$CHECK_OUTPUT" | grep -qiE "unauthorized|forbidden|401|403"; then
        die "Authentication error: $CHECK_OUTPUT

Try re-authenticating: gh auth login"
      else
        warn "API error checking CI status (attempt $CI_API_FAILURES/$MAX_CI_API_FAILURES): $(echo "$CHECK_OUTPUT" | head -1)"
      fi

      if [[ $CI_API_FAILURES -ge $MAX_CI_API_FAILURES ]]; then
        die "gh pr checks failed $MAX_CI_API_FAILURES times due to API errors. Cannot verify CI status.

Last error: $CHECK_OUTPUT

Troubleshooting:
  - Check network: curl -I https://api.github.com
  - Check auth: gh auth status
  - View PR manually: gh pr view $PR_NUMBER --web
  - Skip CI wait: merge-pr $PR_NUMBER --ci-timeout 0"
      fi
      sleep "$CI_POLL_INTERVAL"
      WAITED=$((WAITED + CI_POLL_INTERVAL))
      continue
    fi
  fi

  # Reset API failure counter on successful check retrieval.
  CI_API_FAILURES=0

  # Count statuses — "pass", "fail", "pending".
  PASS_COUNT=$(echo "$CHECK_OUTPUT" | grep -c "pass" || true)
  FAIL_COUNT=$(echo "$CHECK_OUTPUT" | grep -c "fail" || true)
  PENDING_COUNT=$(echo "$CHECK_OUTPUT" | grep -c "pending\|queued\|in_progress" || true)
  TOTAL_CHECKS=$((PASS_COUNT + FAIL_COUNT + PENDING_COUNT))

  # Show progress if status changed.
  STATUS_SUMMARY="$PASS_COUNT pass, $FAIL_COUNT fail, $PENDING_COUNT pending"
  if [[ "$STATUS_SUMMARY" != "$LAST_STATUS_SUMMARY" ]]; then
    info "CI status: $STATUS_SUMMARY (${WAITED}s elapsed)"
    LAST_STATUS_SUMMARY="$STATUS_SUMMARY"
  fi

  if [[ "$FAIL_COUNT" -gt 0 ]]; then
    echo "" >&2
    echo "CI checks failed:" >&2
    echo "$CHECK_OUTPUT" >&2
    echo "" >&2
    die "PR #$PR_NUMBER has $FAIL_COUNT failing CI check(s). Fix them before merging.

View details: gh pr checks $PR_NUMBER
View PR: gh pr view $PR_NUMBER --web"
  fi

  if [[ "$PENDING_COUNT" -eq 0 ]]; then
    # No pending, no failing — checks either passed or there are none.
    if [[ "$TOTAL_CHECKS" -eq 0 ]]; then
      info "No CI checks configured for this PR."
    else
      info "All $PASS_COUNT CI check(s) passed."
    fi
    break
  fi

  if [[ $WAITED -eq 0 ]]; then
    info "Waiting for CI checks to complete (timeout: ${CI_TIMEOUT}s)..."
  fi

  sleep "$CI_POLL_INTERVAL"
  WAITED=$((WAITED + CI_POLL_INTERVAL))
done

if [[ $WAITED -ge $CI_TIMEOUT ]]; then
  warn "CI checks did not complete within ${CI_TIMEOUT}s."
  warn "Current status: $LAST_STATUS_SUMMARY"
  warn "Attempting merge anyway — GitHub will block if checks are required."
fi

# ---------- merge ----------
MERGE_FLAG="--$STRATEGY"
DELETE_FLAG=""
if [[ "$DELETE_BRANCH" == true ]]; then
  DELETE_FLAG="--delete-branch"
fi

# Retry merge operation to handle transient failures.
MERGE_ATTEMPT=0
MAX_MERGE_RETRIES=3
MERGE_SUCCESS=false

while [[ $MERGE_ATTEMPT -lt $MAX_MERGE_RETRIES ]]; do
  MERGE_ATTEMPT=$((MERGE_ATTEMPT + 1))

  MERGE_OUTPUT=$(gh pr merge "$PR_NUMBER" $MERGE_FLAG $DELETE_FLAG 2>&1) && {
    MERGE_SUCCESS=true
    break
  }

  MERGE_EXIT=$?

  # Check if it was merged by someone else in the meantime.
  RECHECK_STATE=$(gh pr view "$PR_NUMBER" --json state --jq '.state' 2>/dev/null || true)
  if [[ "$RECHECK_STATE" == "MERGED" ]]; then
    info "PR #$PR_NUMBER was merged concurrently."
    MERGE_SUCCESS=true
    break
  fi

  # Classify error to determine if we should retry.
  SHOULD_RETRY=false
  if echo "$MERGE_OUTPUT" | grep -qiE "timeout|timed out|connection|network|rate limit|502|503|504|500"; then
    SHOULD_RETRY=true
    warn "Transient error merging PR (attempt $MERGE_ATTEMPT/$MAX_MERGE_RETRIES): $(echo "$MERGE_OUTPUT" | head -1)"
  elif echo "$MERGE_OUTPUT" | grep -qiE "required status check|review required|not mergeable|conflict"; then
    die "Cannot merge PR #$PR_NUMBER: $MERGE_OUTPUT

Common fixes:
  - Resolve merge conflicts: gh pr view $PR_NUMBER --web
  - Wait for required checks: gh pr checks $PR_NUMBER
  - Request reviews: gh pr review $PR_NUMBER"
  elif echo "$MERGE_OUTPUT" | grep -qiE "unauthorized|forbidden|401|403"; then
    die "Permission error merging PR #$PR_NUMBER: $MERGE_OUTPUT

Try re-authenticating: gh auth login"
  else
    # Unknown error — retry once.
    SHOULD_RETRY=true
    warn "Unknown error merging PR (attempt $MERGE_ATTEMPT/$MAX_MERGE_RETRIES): $(echo "$MERGE_OUTPUT" | head -1)"
  fi

  if [[ "$SHOULD_RETRY" == true && $MERGE_ATTEMPT -lt $MAX_MERGE_RETRIES ]]; then
    MERGE_SLEEP=$((2 ** MERGE_ATTEMPT))
    warn "Retrying in ${MERGE_SLEEP}s..."
    sleep "$MERGE_SLEEP"
  else
    break
  fi
done

if [[ "$MERGE_SUCCESS" == false ]]; then
  die "Failed to merge PR #$PR_NUMBER after $MAX_MERGE_RETRIES attempts.

Last error: $MERGE_OUTPUT

Troubleshooting:
  - View PR: gh pr view $PR_NUMBER --web
  - Check status: gh pr view $PR_NUMBER
  - Manual merge: gh pr merge $PR_NUMBER --$STRATEGY"
fi

info "PR #$PR_NUMBER merged successfully ($STRATEGY)."

# ---------- branch cleanup ----------
# Handle branch deletion errors gracefully. The merge may have already
# deleted the remote branch, or deletion may fail due to branch protection.
if [[ "$DELETE_BRANCH" == true && -n "$PR_BRANCH" ]]; then
  # Clean up local branch reference if it exists.
  if git show-ref --verify --quiet "refs/heads/$PR_BRANCH" 2>/dev/null; then
    # Don't delete if we're currently on this branch.
    CURRENT_BRANCH=$(git branch --show-current 2>/dev/null || true)
    if [[ "$CURRENT_BRANCH" == "$PR_BRANCH" ]]; then
      warn "Currently on branch '$PR_BRANCH'. Switching to main before cleanup."
      git checkout main 2>/dev/null || git checkout master 2>/dev/null || warn "Could not switch away from '$PR_BRANCH'."
    fi

    git branch -d "$PR_BRANCH" 2>/dev/null \
      || warn "Could not delete local branch '$PR_BRANCH'. It may have unmerged changes — use 'git branch -D $PR_BRANCH' to force-delete."
  fi

  # Prune stale remote tracking refs.
  git remote prune origin 2>/dev/null || true
fi

# ---------- update local main ----------
CURRENT_BRANCH=$(git branch --show-current 2>/dev/null || true)
if [[ "$CURRENT_BRANCH" == "main" || "$CURRENT_BRANCH" == "master" ]]; then
  info "Pulling latest changes on $CURRENT_BRANCH..."
  git pull --ff-only 2>/dev/null || warn "Could not fast-forward $CURRENT_BRANCH."
fi

info "Done. PR #$PR_NUMBER merged via $STRATEGY."
